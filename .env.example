# ============================================================
# TalkBridge — Environment Configuration (ALL OPTIONAL / FREE)
# Copy this file to ".env" and fill in only what you want.
# The app runs 100% free with NOTHING set (browser STT + HF public tier).
# ============================================================

# --- HuggingFace (optional, free) ---
# A free HF token raises rate limits on the Inference API.
# Get one at https://huggingface.co/settings/tokens (no payment needed).
HF_API=

# Translation model — ANY HuggingFace model id works.
# Default: NLLB-200 distilled (200 languages, free).
HF_MODEL=facebook/nllb-200-distilled-600M

# Speech-to-text model (server-side Whisper; browser STT is used by default).
HF_STT_MODEL=openai/whisper-large-v3-turbo

# --- Groq (optional, free tier) ---
# Used only as a fast STT fallback if you set a key (https://console.groq.com).
GROQ_API_KEY=

# --- Translation provider selection (auto | hf | libretranslate) ---
# auto  = use HF if HF_API set, else public LibreTranslate (free)
# hf    = force HuggingFace
# libretranslate = force a LibreTranslate instance
TRANSLATION_PROVIDER=auto

# --- Self-hosted LibreTranslate (optional) ---
# If you run your own LibreTranslate (Docker: libretranslate/libretranslate)
# point this at it, e.g. https://translate.yourserver.com
LIBRETRANSLATE_URL=

# --- Public URLs / ICE (for production deploy) ---
# Set this to your deployed domain so sockets connect cross-origin in prod.
NUXT_PUBLIC_SOCKET_URL=

# Optional TURN server (only needed for strict/symmetric NAT).
# Public STUN is enough for most home networks.
# Example JSON: [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:YOUR_TURN","username":"u","credential":"p"}]
NUXT_PUBLIC_ICE_SERVERS=
